{
  "name": "llm-json-extract",
  "version": "0.6.1",
  "description": "Extract & validate JSON from messy LLM output. Designed for Claude / Codex CLI workflows where tool-use is unavailable. XML-tag aware, with multi-stage fallbacks and jsonrepair.",
  "keywords": [
    "llm",
    "json",
    "extract",
    "parse",
    "claude",
    "anthropic",
    "openai",
    "codex",
    "xml",
    "structured-output",
    "jsonrepair",
    "zod",
    "valibot",
    "schema"
  ],
  "license": "MIT",
  "author": "Keisuke Karijuku <keisuke.karijuku@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifapmzadu6/llm-json-extract.git"
  },
  "bugs": {
    "url": "https://github.com/ifapmzadu6/llm-json-extract/issues"
  },
  "homepage": "https://github.com/ifapmzadu6/llm-json-extract#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:smoke": "node test/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jsonrepair": "^3.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^26.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
