{
  "name": "llm-json-extract",
  "version": "2.0.0",
  "description": "Extract & validate JSON from messy LLM output. Designed for Claude / Codex CLI workflows where tool-use is unavailable. XML-tag aware, with multi-stage fallbacks and built-in repair.",
  "keywords": [
    "llm",
    "json",
    "extract",
    "cli",
    "parse",
    "claude",
    "anthropic",
    "openai",
    "codex",
    "xml",
    "structured-output",
    "json-repair",
    "zod",
    "valibot",
    "schema"
  ],
  "license": "MIT",
  "author": "Keisuke Karijuku <keisuke.karijuku@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifapmzadu6/llm-json-extract.git"
  },
  "bugs": {
    "url": "https://github.com/ifapmzadu6/llm-json-extract/issues"
  },
  "homepage": "https://github.com/ifapmzadu6/llm-json-extract#readme",
  "type": "module",
  "bin": {
    "llm-json-extract": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly --declarationMap false && node scripts/finalize-types.mjs",
    "check:package": "attw --pack .",
    "test": "vitest run",
    "test:smoke": "node test/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
